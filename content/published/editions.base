filters:
  and:
    - file.inFolder("published")
    - file.ext == "md"
    - file.name != "index"
    - file.hasProperty("author")
formulas:
  book: link(file.path, note.title)
properties:
  formula.book:
    displayName: 书名
  author:
    displayName: 作者
  year:
    displayName: 年份
  status:
    displayName: 状态
  formats:
    displayName: 格式
views:
  - type: cards
    name: 卡片
    order:
      - author
      - year
      - status
      - formats
    sort:
      - property: year
        direction: DESC
    image: note.cover
    imageAspectRatio: 1
    imageFit: contain
    cardSize: 230
  - type: table
    name: 表格
    order:
      - formula.book
      - author
      - year
      - status
      - formats
    sort:
      - property: year
        direction: DESC
