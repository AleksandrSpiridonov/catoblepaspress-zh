filters:
  and:
    - file.inFolder("authors")
    - file.ext == "md"
    - file.name != "index"
formulas:
  author: link(file.path, note.title)
properties:
  formula.author:
    displayName: 姓名
  tags:
    displayName: 标签
  books:
    displayName: 图书
views:
  - type: cards
    name: 作者
    order:
      - tags
    sort:
      - property: title
        direction: ASC
    image: note.avatar
    imageAspectRatio: 1
    imageFit: cover
    cardSize: 180
  - type: table
    name: 表格
    order:
      - formula.author
      - tags
      - books
    sort:
      - property: title
        direction: ASC
